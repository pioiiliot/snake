<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My First Web Platform</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 600px;
      margin: 50px auto;
      padding: 20px;
      text-align: center;
      background-color: #f4f4f9;
      color: #333;
    }
    .card {
      background: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    input {
      padding: 10px;
      width: 65%;
      margin-right: 5px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }
    button {
      padding: 10px 15px;
      background-color: #2da44e;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    button:hover { background-color: #2c974b; }
    ul { list-style: none; padding: 0; margin-top: 20px; }
    li {
      background: #fff;
      padding: 10px;
      margin: 8px 0;
      border-radius: 4px;
      border: 1px solid #e1e4e8;
      text-align: left;
    }
  </style>
</head>
<body>

  <div class="card">
    <h1>My Custom Platform</h1>
    <p>Post updates or store temporary notes below:</p>
    
    <input type="text" id="userInput" placeholder="Type a message or note...">
    <button onclick="addPost()">Publish</button>

    <ul id="postList"></ul>
  </div>

  <script>
    function addPost() {
      const input = document.getElementById('userInput');
      const text = input.value.trim();
      
      if (text !== '') {
        const li = document.createElement('li');
        li.textContent = text;
        document.getElementById('postList').appendChild(li);
        input.value = '';
      }
    }
  </script>

</body>
</html>
